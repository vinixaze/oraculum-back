# .env.example - COPIAR E RENOMEAR PARA .env

# Porta (Railway define automaticamente)
PORT=5000

# Ambiente
NODE_ENV=production

# Frontend URL (ajustar para produção)
FRONTEND_URL=https://seu-frontend.vercel.app

# PostgreSQL URL (pegar do Railway)
DATABASE_URL=postgresql://postgres:SENHA@autorack.proxy.rlwy.net:PORTA/railway
